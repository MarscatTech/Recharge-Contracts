# ─── Network ─────────────────────────────────────────────────────
# Node JSON-RPC url
BSC_JSON_RPC=
BSC_TEST_JSON_RPC=

# ─── Accounts ────────────────────────────────────────────────────
# Contract owner (ownership is transferred to this address on deploy)
NEW_OWNER_ADDRESS=
# Private key for the signing wallet — do NOT commit the real key.
# For token-management scripts this MUST be the current owner's key.
PRIVATE_KEY=

# ─── Deploy: package config ──────────────────────────────────────
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Quarterly package type
PACKAGE_QUARTERLY=1
# Yearly package type
PACKAGE_YEARLY=2
# Quarterly package price
QUARTERLY_PRICE=9.9
# Yearly package price
YEARLY_PRICE=29.9
# Quarterly duration in seconds
QUARTERLY_DURATION=7776000
# Yearly duration in seconds
YEARLY_DURATION=31536000

# ─── Token management scripts ────────────────────────────────────
# Deployed (production) subscription contract address
CONTRACT_ADDRESS=0x50EC450822d4fbF29eAA67e44F5F38b8A5FC14a6

# add-token: token to enable + its prices (human-readable, auto-scaled by decimals)
NEW_TOKEN_ADDRESS=0xd69a4b260ef021CCD4e1C5F5a4fB522B032Ce831
NEW_TOKEN_QUARTERLY_PRICE=
NEW_TOKEN_YEARLY_PRICE=

# disable-token: token to disable (set its price unpayably high)
# Default: BSC USDT
DISABLE_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# list-tokens: tokens to check (comma-separated). If empty, falls back
# to USDT_ADDRESS + NEW_TOKEN_ADDRESS.
CHECK_TOKENS=

# Set to true on any script to preview without sending transactions
DRY_RUN=false
